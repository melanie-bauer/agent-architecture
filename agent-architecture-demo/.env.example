# Copy to .env and fill in.
OPENAI_API_KEY=
# live = real OpenAI, mock = scripted offline model. Default: live if a key is set, otherwise mock.
DEMO_MODE=live
# Planner example only (overrides DEMO_MODE for the 15 planner agents): live | mock
# PLANNER_MODE=mock
# Planner network transport: a2a (default, specialists/peers called over HTTP) | local (in-process)
# PLANNER_TRANSPORT=a2a
# Optional model overrides
# MODEL_LARGE=gpt-6.1-sol
# MODEL_SMALL=gpt-6-luna
MASTRA_TELEMETRY_DISABLED=1
