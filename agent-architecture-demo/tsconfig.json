{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "moduleDetection": "force",
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src",
    "scripts",
    "test"
  ]
}